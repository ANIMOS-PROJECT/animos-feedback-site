---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | ANIMOS PROJECT 防災意見収集サイト</title>
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}/favicon.svg`} />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a href={`${baseUrl}/`} class="logo">ANIMOS PROJECT <span>防災意見収集モデル</span></a>
        <nav class="nav">
          <a href={`${baseUrl}/`}>趣旨説明</a>
          <a href={`${baseUrl}/form`} class="btn-nav">意見を入力する</a>
          <a href={`${baseUrl}/contact`}>お問い合わせ</a>
        </nav>
      </div>
    </header>

    <main class="main-content">
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>&copy; ANIMOS PROJECT 開発部門. All Rights Reserved.</p>
        <p class="disclaimer">※本サイトは緊急時の被災状況報告用ではありません。</p>
      </div>
    </footer>
  </body>
</html>
